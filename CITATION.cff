  - alias: v0xeII
repository-code: "https://github.com/redbluecarrot/SpinSlicer"
url: "https://redbluecarrot.github.io/SpinSlicer/"
license: MIT
version: 0.7.0
date-released: 2026-11-06
keywords:
  - computed axial lithography
  - volumetric additive manufacturing
  - volumetric 3D printing
  - tomographic printing
  - slicer
  - photopolymer
